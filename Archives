<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Archives des contrôles – 1BAC Sciences Maths (BIOF)</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Sora:wght@500;600;700;800&family=Manrope:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#f5f7fc;--card:#fff;--ink:#0b1633;--mute:#55607f;--line:#dde3f1;--navy:#081230;--navy2:#10285c;--gold:#f6c244;--cyan:#4cc9f0;--on:#f3f6ff;--on-m:#b8c3e3;
--hd:'Sora','Segoe UI',Arial,sans-serif;--bd:'Manrope','Segoe UI',Arial,sans-serif;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
@media(prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#070e24;--card:#0e1a3d;--ink:#eef2ff;--mute:#a5b0d3;--line:#1f2e5c}}
:root[data-theme="dark"]{--bg:#070e24;--card:#0e1a3d;--ink:#eef2ff;--mute:#a5b0d3;--line:#1f2e5c}
*,*::before,*::after{box-sizing:border-box}
html{scroll-padding-top:calc(72px + env(safe-area-inset-top,0px))}
body{margin:0;background:var(--bg);color:var(--ink);font:400 1.02rem/1.65 var(--bd);-webkit-font-smoothing:antialiased;overflow-x:hidden}
h1,h2,h3{font-family:var(--hd);margin:0;line-height:1.15;letter-spacing:-.02em}
a{color:inherit}
:focus-visible{outline:3px solid var(--gold);outline-offset:3px;border-radius:8px}
.wrap{width:min(1040px,100% - 2.5rem);margin-inline:auto}
header{background:linear-gradient(160deg,var(--navy) 20%,var(--navy2));color:var(--on);padding:calc(1.2rem + env(safe-area-inset-top,0px)) 0 3.2rem}
.top{display:flex;justify-content:space-between;align-items:center;gap:1rem;flex-wrap:wrap;margin-bottom:2.6rem}
.back{display:inline-flex;gap:.5rem;align-items:center;text-decoration:none;color:var(--on-m);font-size:.94rem}
.back:hover{color:var(--gold)}
.top b{font:700 1rem var(--hd)}
h1{font-size:clamp(2rem,5vw,3.3rem);font-weight:800;max-width:20ch}
header p{color:var(--on-m);max-width:60ch;margin:1rem 0 0}
.bar{position:sticky;top:0;z-index:5;background:var(--bg);border-bottom:1px solid var(--line);padding:1rem 0 .9rem;padding-top:calc(1rem + env(safe-area-inset-top,0px))}
.row{display:flex;gap:.45rem;flex-wrap:wrap;align-items:center}
.row+.row{margin-top:.6rem}
.row span{font:600 .85rem var(--bd);color:var(--mute);min-width:5.2rem}
.chip{border:1.5px solid var(--line);background:var(--card);color:var(--ink);border-radius:999px;padding:.35rem .9rem;font:500 .88rem var(--bd);cursor:pointer;transition:background .2s,border-color .2s}
.chip:hover{border-color:var(--cyan)}
.chip[aria-pressed=true]{background:var(--gold);border-color:var(--gold);color:#1b1403;font-weight:600}
main{padding:2.2rem 0 4rem}
.yr{background:var(--card);border:1px solid var(--line);border-radius:22px;padding:1.6rem;margin-bottom:1.2rem}
.yr>h2{font-size:1.5rem;display:flex;justify-content:space-between;align-items:baseline;gap:1rem;flex-wrap:wrap}
.yr>h2 a{font:500 .85rem var(--bd);color:var(--mute)}
.sem{display:grid;grid-template-columns:1fr 1fr;gap:1.4rem;margin-top:1.1rem}
.sem h3{font-size:1rem;color:var(--mute);font-weight:600;margin-bottom:.5rem}
.ct{padding:.7rem 0;border-top:1px solid var(--line)}
.ct b{display:block;font:600 .92rem var(--hd);margin-bottom:.45rem}
.ls{display:flex;flex-wrap:wrap;gap:.4rem}
.ls a{text-decoration:none;font-size:.86rem;padding:.3rem .8rem;border-radius:999px;background:rgba(76,201,240,.13);border:1px solid rgba(76,201,240,.4);transition:background .2s,transform .2s}
.ls a:hover{background:var(--gold);border-color:var(--gold);color:#1b1403;transform:translateY(-2px)}
.off{color:var(--mute);margin-top:.6rem}
.off a{color:var(--ink);font-weight:600}
.empty{text-align:center;color:var(--mute);padding:3rem 0}
.note{font-size:.86rem;color:var(--mute);margin-top:2rem;max-width:70ch}
footer{background:var(--navy);color:var(--on-m);padding:2rem 0;font-size:.88rem}
@media(max-width:760px){.sem{grid-template-columns:1fr}.row span{width:100%}}
@media(prefers-reduced-motion:reduce){*{transition:none!important}}
</style>
</head>
<body>
<header><div class="wrap">
<div class="top"><a class="back" href="index.html">← Retour au site</a><b>Anass Chliah</b></div>
<h1>Archives des contrôles · 1BAC Sciences Maths (BIOF)</h1>
<p>Tous les contrôles de chaque matière, classés par année. Les sujets viennent du site officiel d’Anisse International School.</p>
</div></header>

<div class="bar"><div class="wrap">
<div class="row"><span>Matière</span><div class="row" id="fs" role="group" aria-label="Filtrer par matière"></div></div>
<div class="row"><span>Année</span><div class="row" id="fy" role="group" aria-label="Filtrer par année"></div></div>
</div></div>

<main><div class="wrap">
<div id="out"></div>
<p class="note">Les sujets appartiennent à l’établissement et sont ouverts depuis son site. Pour les années sans liens directs ici, la page officielle de l’année contient tous les sujets.</p>
</div></main>

<footer><div class="wrap">© 2026 Anass Chliah · Archives non officielles, à usage d’entraînement.</div></footer>

<script>
const R='https://www.lyceeanisse.org/images/stories/Pdf_Anisse/',P='https://www.lyceeanisse.org/accueil/';
const SUBJ=['Maths','Physique-Chimie','SVT','Anglais','Philosophie','Français','Éd. Islamique','Arabe','Hist-Géo'];
const A={Maths:'Maths',PC:'Physique-Chimie',SVT:'SVT',En:'Anglais',Ph:'Philosophie',Fr:'Français',EI:'Éd. Islamique',Ar:'Arabe',HG:'Hist-Géo'};
// [semestre, contrôle, matière, fichier]
const D=(s,c,t)=>t.split(';').map(x=>{const[k,f]=x.split('=');return[s,c,A[k],f]});
const g=(s,c,t)=>D(s,c,t).map(([a,b,m,f])=>[a,b,m,`GSA_1BAC_1819_S${s}_C${c}_`+f+'.pdf']);
const Y=[
{y:'2025-2026',p:'2025-2026-1-ere-bac-sc-math-fr/',d:'2025-2026/Examen/Examen_lycee/',e:[
...D(1,1,'Maths=Maths 1 SM Sem1 25-26 Copy.pdf;En=Anglais 1 - Sem1 25-26 Copy.pdf;Ph=Philo 1 - Sem1 25-26 Copy.pdf;PC=PC 1 SM Sem1 25-26 Copy.pdf;Fr=Français 1BAC CC1 S125-26 Copy.pdf;EI=I. Islamique 1 - Sem1 25-26 Copy.pdf;Ar=Arabe 1 - Sem1 25-26 Copy.pdf;HG=Hist.Géo 1 - Sem1 25-26 Copy.pdf'),
[1,1,'SVT','https://www.lyceeanisse.org/accueil/2025-2026-1-ere-bac-sc-math-fr/SVT 1BAC-SM CC1 S1 25-26 Géologie Copy.pdf'],
...D(1,2,'Maths=Maths 2 SM Sem1 25-26 Copy.pdf;En=Anglais 2 - Sem1 25-26 Copy.pdf;Ph=Philo 2 - Sem1 25-26 Copy.pdf;PC=PC 2 SM Sem1 25-26 Copy.pdf;Fr=Français 2 - Sem1 25-26 Copy.pdf;SVT=SVT 2 SM Sem1 25-26 Géologie Copy.pdf;EI=I. Islamique 2 - Sem1 25-26 Copy.pdf;Ar=Arabe 2 - Sem1 25-26 Copy.pdf;HG=Hist.Géo 2 - Sem1 25-26 Copy.pdf'),
...D(1,3,'Maths=Maths 3 SM Sem1 25-26 Copy.pdf;En=Anglais 3 - Sem1 25-26 Copy.pdf;PC=PC 3 SM Sem1- 25-26 Copy.pdf;Fr=Français 3 - Sem1 25-26 Copy.pdf'),
...D(2,1,'Maths=Maths 1 SM Sem2 25-26 Copy.pdf;En=Anglais 1 - Sem2 25-26 - Copie Copy.pdf;Ph=Philo 1 - Sem2 25-26 Copy.pdf;PC=PC 1 SM Sem2 25-26 Copy.pdf;SVT=SVT 1 SM Sem2 25-26 Copy.pdf'),
...D(2,2,'Maths=Maths 2 SM Sem2 25-26 Copy.pdf;PC=PC 2 SM Sem2 25-26 Copy.pdf;En=Anglais 2 - Sem2 25-26 Copy.pdf;SVT=SVT 2 SM Sem2 25-26 Copy.pdf'),
...D(2,3,'Maths=Maths 3 SM Sem2 25-26 Copy.pdf;En=Anglais 3- Sem2 25-26 Copy.pdf;Ph=Philo 2 - Sem2 25-26 Copy.pdf;PC=PC 3 SM Sem2 25-26 Copy.pdf')]},
{y:'2024-2025',p:'2024-2025-1-ere-bac-sc-math-fr/',d:'2024-2025/Examen/Examen_lycee/',e:[
...D(1,1,'Maths=Maths 1 SM Sem1 24 - 25.pdf;En=Anglais 1 - Sem1 24 - 25.pdf;Ph=Philo 1 - Sem1 24 - 25.pdf;PC=PC 1 SM Sem1 24 - 25.pdf;Fr=Français 1 - Sem1 24 - 25.pdf;SVT=SVT 1 SM Sem1 24 - 25 Géologie.pdf;EI=I. Islamique 1 - Sem1 24 - 25 1bac.pdf;Ar=Arabe 1 - Sem1 24 - 25 1bac.pdf;HG=Hist.Géo 1 - Sem1 24 - 25.pdf'),
...D(1,2,'Maths=Maths 2 SM Sem1 24 - 25 (1).pdf;En=Anglais 2 - Sem1 24 - 25 (1).pdf;PC=PC 2 SM Sem1 24 - 25 (1).pdf;Fr=Français 2 - Sem1 24 - 25 (1).pdf;SVT=1BAC SVT 2 SM Sem1 24 - 25 Géologie.pdf'),
...D(1,3,'Maths=Mathd 3 SM Sem1 24 - 25.pdf;En=Anglais 3 - Sem1 24 - 25.pdf;Ph=Philo 2 - Sem1 24 - 25.pdf;PC=PC 3 SM Sem1 24 - 25.pdf;Fr=Français 3 - Sem1 24 - 25.pdf;EI=I. Islamique 2 - Sem1 24 - 25.pdf;Ar=Arabe 2 - Sem1 24 - 25.pdf;HG=Hist.Géo 2 - Sem1 24 - 25.pdf'),
...D(2,1,'Maths=Maths 1 SM Sem2 24 - 25.pdf;En=Anglais 1 - Sem2 24 - 25 Copy.pdf;Ph=Philo 1 - Sem2 24 - 25 Copy.pdf;PC=PC 1 SM Sem2 24 - 25.pdf;SVT=SVT 1 SM Sem2 24 - 25.pdf'),
...D(2,2,'Maths=Maths 2 SM Sem2 24 - 25.pdf;PC=PC 2 SM Sem2 24 - 25.pdf;En=Anglais 2 - Sem2 24 - 25.pdf;SVT=SVT 2 SM Sem2 24 - 25.pdf'),
...D(2,3,'Maths=Maths 3 SM Sem2 24 - 25.pdf;En=Anglais 3 - Sem2 24 - 25.pdf;Ph=Philo 2 - Sem2 24 - 25.pdf;PC=PC 3 SM Sem2 24 - 25.pdf')]},
{y:'2023-2024',p:'2023-2024-1-ere-bac-sc-math-fr/'},
{y:'2022-2023',p:'2022-2023-1-ere-bac-sc-math-fr/'},
{y:'2021-2022',p:'2021-2022-1-ere-bac-sc-math-fr/'},
{y:'2019-2020',p:'2019-2020-1-ere-bac-sc-math-fr/'},
{y:'2018-2019',p:'2018-2019-1-ere-bac-sc-math-fr/',d:'2018-2019/Examen/Examen_lycee/',e:[
...g(1,1,'Maths=SM_Maths;En=Anglais;Ph=Philosophie;PC=SMF_PC;Fr=Francais;SVT=SM_SVT;EI=EI;Ar=Arabe;HG=HG'),
...g(1,2,'Maths=SMF_Maths;PC=SM_PC;En=Anglais;Fr=Francais'),
...g(1,3,'Maths=SM_Maths;En=Anglais;Ph=Philosophie;PC=SM_PC;Fr=Francais;SVT=SM_SVT;EI=EI;Ar=Arabe;HG=HG'),
...g(2,1,'Maths=SMF_Maths;En=Anglais;Ph=Philosophie;PC=SMF_PC;Fr=Francais;SVT=SM_SVT;EI=EI;Ar=Arabe;HG=HG'),
...g(2,2,'Maths=SMF_Maths;PC=SMF_PC'),
...g(2,3,'Maths=SMF_Maths;En=Anglais;Ph=Philosophie;PC=SMF_PC;Fr=Francais;SVT=SMF_SVT;EI=EI;Ar=Arabe;HG=HG')]},
{y:'2017-2018',p:'2017-2018-1-ere-bac-sc-math-fr/'},
{y:'2016-2017',p:'2016-2017-1-ere-bac-sc-math-fr/'},
{y:'2015-2016',p:'2015-2016-1-ere-bac-scmath-fr/'}
];
const $=s=>document.querySelector(s);
let fs='Toutes',fy='Toutes';
function url(y,e){const[s,c,,f]=e;return f.startsWith('http')?encodeURI(f):R+y.d+`Semestre_${s}/Controle_${c}/1BAC/SM/`+encodeURI(f)}
function chips(id,list,get,set){$(id).innerHTML='';['Toutes',...list].forEach(v=>{const b=document.createElement('button');b.type='button';b.className='chip';b.textContent=v;b.setAttribute('aria-pressed',get()===v);b.onclick=()=>{set(v);render()};$(id).append(b)})}
function render(){
chips('#fs',SUBJ,()=>fs,v=>fs=v);chips('#fy',Y.map(y=>y.y),()=>fy,v=>fy=v);
const o=$('#out');o.innerHTML='';let n=0;
Y.filter(y=>fy==='Toutes'||fy===y.y).forEach(y=>{
const es=(y.e||[]).filter(e=>fs==='Toutes'||e[2]===fs);
if(y.e&&!es.length)return;
n++;const s=document.createElement('section');s.className='yr';
let h=`<h2>${y.y}<a href="${P+y.p}" target="_blank" rel="noopener">Page officielle du lycée ↗</a></h2>`;
if(!y.e){h+=`<p class="off">Les liens directs de cette année ne sont pas encore ajoutés ici. <a href="${P+y.p}" target="_blank" rel="noopener">Ouvrir tous les sujets ${y.y}</a></p>`}
else{h+='<div class="sem">';[1,2].forEach(sm=>{h+=`<div><h3>Semestre ${sm}</h3>`;[1,2,3].forEach(c=>{const l=es.filter(e=>e[0]===sm&&e[1]===c);if(l.length)h+=`<div class="ct"><b>Contrôle n°${c}</b><div class="ls">${l.map(e=>`<a href="${url(y,e)}" target="_blank" rel="noopener">${e[2]}</a>`).join('')}</div></div>`});h+='</div>'});h+='</div>'}
s.innerHTML=h;o.append(s)});
if(!n)o.innerHTML='<p class="empty">Aucun contrôle pour ce filtre. Essayez une autre matière ou une autre année.</p>'}
render();
</script>
</body>
</html>
